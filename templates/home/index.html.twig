{% extends 'base.html.twig' %}

{% block title %}Campus Protocol | Accueil{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('assets/css/variables.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/css/global.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/css/home-intro.css') }}">
{% endblock %}

{% block body %}
    <script>
        (function() {
            try {
                if (window.localStorage.getItem('campus-intro-done-v2') !== 'true') {
                    document.body.classList.add('intro-active');
                }
            } catch (e) {
                document.body.classList.add('intro-active');
            }
        })();
    </script>
    <div id="intro-screen" class="intro-screen" aria-hidden="true">
        <div class="intro-terminal">
            <div class="intro-header">
                <span>boot@campus-protocol</span>
                <span>tty1</span>
            </div>
            <div class="intro-body">
                <div id="intro-lines" class="intro-lines"></div>
                <div id="intro-prompt" class="intro-prompt is-hidden">
                    <div class="intro-question">Activer l'ambiance sonore (recommande) ?</div>
                    <div class="intro-actions">
                        <button id="intro-yes" type="button" class="intro-btn intro-yes">Yes</button>
                        <button id="intro-no" type="button" class="intro-btn intro-no">No</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="home-content" class="page">
        <div class="container">
            <section class="console-shell">
                <div class="console-header">
                    <span>campus-protocol@terminal</span>
                    <span>build: retro-01</span>
                </div>
                <h1 class="console-title">Campus Protocol</h1>
                <p class="console-subtitle">
                    Acces direct au mode combat et au bestiaire.
                </p>
                <div class="console-menu">
                    <a class="console-button" href="{{ path('app_combat') }}">
                        Lancer combat 1v1
                    </a>
                    <a class="console-button" href="{{ path('app_bestiaire') }}">
                        Ouvrir bestiaire
                    </a>
                </div>
                <div class="console-log">
                    <div class="line"><span class="prompt">$</span> status: ready</div>
                    <div class="line"><span class="prompt">></span> mercure: active</div>
                    <div class="line"><span class="prompt">></span> creatures: 12 loaded</div>
                </div>
            </section>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('assets/js/home-intro.js') }}" defer></script>
    <script src="{{ asset('assets/js/audio-player.js') }}" defer></script>
{% endblock %}
